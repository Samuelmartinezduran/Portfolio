{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/servicios/:ruta*", "destination": "/", "permanent": true },
    { "source": "/desarrollo-web-vigo", "destination": "/", "permanent": true },
    { "source": "/desarrollo-web-vigo/", "destination": "/", "permanent": true },
    { "source": "/seo-local-vigo", "destination": "/", "permanent": true },
    { "source": "/seo-local-vigo/", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/proyectos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
