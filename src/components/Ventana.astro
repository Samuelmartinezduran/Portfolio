---
// Barra de ventana común a la portada y a las páginas de proyecto: puntos, ruta y el CV siempre a mano.
// En las páginas de proyecto, «~/portfolio» lleva a la portada. Lo que se pase como hijo va a la derecha.
import { persona } from "../data/perfil";

interface Props {
  /** Lo que va detrás de «~/portfolio», por ejemplo «/proyectos/deep-prep». */
  ruta?: string;
}

const { ruta = "" } = Astro.props;
---

<header class="ventana">
  <span class="ventana__puntos" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="mono ventana__ruta">
    samuel@vigo: {ruta ? <a href="/">~/portfolio</a> : "~/portfolio"}{ruta}
  </span>
  <a class="mono ventana__cv" href={persona.cv}>cv.pdf</a>
  <slot />
</header>

<style>
  .ventana {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--margen);
    background: var(--fondo);
    border-bottom: 1px solid var(--borde-oscuro);
  }

  .ventana__puntos {
    display: flex;
    gap: 0.375rem;
  }

  .ventana__puntos i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--borde-oscuro);
  }

  .ventana__puntos i:first-child {
    background: var(--acento);
  }

  .ventana__ruta {
    min-width: 0;
    font-size: 0.8125rem;
    color: var(--texto-2-oscuro);
    overflow-wrap: anywhere;
  }

  .ventana__ruta a {
    color: var(--blanco);
  }

  .ventana__cv {
    margin-left: auto;
    padding: 0.5rem 0.25rem;
    font-size: 0.8125rem;
    color: var(--blanco);
    text-decoration: none;
  }

  .ventana__cv:hover {
    color: var(--acento);
  }
</style>
