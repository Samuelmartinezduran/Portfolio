  }

  .ventana__puntos i:first-child {
    background: var(--acento);
  }

  .ventana__ruta {
    font-size: 0.8125rem;
    color: var(--texto-2-oscuro);
  }

  .ventana__cv {
    margin-left: auto;
    padding: 0.5rem 0.25rem;
    font-size: 0.8125rem;
    color: var(--blanco);
