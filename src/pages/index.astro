---
// Portada. La web se presenta como una herramienta de desarrollador: una terminal que ejecuta las pruebas
// reales, paleta de comandos (Ctrl/Cmd+K) y atajos, y el perfil y los proyectos como archivos abiertos.
// Ver DESIGN.md y los ADR «Dirección Terminal» y «Revisión de coherencia, SEO y GEO».
import Pagina from "../layouts/Pagina.astro";
import {
  actualizada,
  agenda,
  cursos,
  datosPersonales,
  estado,
  experiencia,
  formacion,
  habilidades,
  llamada,
  persona,
  proyectos,
  sesionTerminal,
  sobreMi,
} from "../data/perfil";
import { gaActivo } from "../lib/analitica";

const titulo = "Samuel Martínez Durán · Desarrollador web en Vigo";
const descripcion =
  "Desarrollador web en Vigo con Python y TypeScript. Proyectos con código y pruebas: una app de escritorio publicada, un agente de voz y agenteval.";

const sitio = Astro.site!;
const abs = (ruta: string) => new URL(ruta, sitio).href;
const idPersona = abs("/#samuel");
const licencias: Record<string, string> = { MIT: "https://opensource.org/licenses/MIT" };
const fechaLarga = new Intl.DateTimeFormat("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${actualizada}T00:00:00Z`));

// Datos estructurados propios de la portada: página de perfil, repositorios públicos y el vídeo de Deep Prep.
const grafo: Record<string, unknown>[] = [
  {
    "@type": "ProfilePage",
    "@id": abs("/#perfil"),
    url: abs("/"),
    name: titulo,
    description: descripcion,
    inLanguage: "es-ES",
    // Google pide fecha y hora (ISO 8601 con zona) para ProfilePage.
    dateModified: `${actualizada}T00:00:00+01:00`,
    isPartOf: { "@id": abs("/#web") },
    mainEntity: { "@id": idPersona },
  },
  ...proyectos.flatMap((p) =>
    p.repo
      ? [
          {
            "@type": "SoftwareSourceCode",
            "@id": abs(`/#${p.id}`),
            name: p.nombre,
            description: p.resumen,
            url: abs(`/#${p.id}`),
            codeRepository: p.repo.url,
            programmingLanguage: p.repo.lenguaje,
            license: licencias[p.repo.licencia] ?? p.repo.licencia,
            author: { "@id": idPersona },
            ...(p.video ? { video: { "@id": abs(`/#${p.id}-video`) } } : {}),
          },
        ]
      : [],
  ),
  ...proyectos.flatMap((p) =>
    p.video
      ? [
          {
            "@type": "VideoObject",
            "@id": abs(`/#${p.id}-video`),
            name: `${p.nombre} en funcionamiento`,
            description: p.video.alt,
            thumbnailUrl: abs(p.video.poster),
            contentUrl: abs(p.video.src),
            uploadDate: p.video.fecha,
            duration: p.video.duracion,
            width: p.video.ancho,
            height: p.video.alto,
            creator: { "@id": idPersona },
          },
        ]
      : [],
  ),
];

const comandos = [
  { texto: "Ir a proyectos", atajo: "1", accion: "#proyectos" },
  { texto: "Ir a experiencia", atajo: "2", accion: "#experiencia" },
  { texto: "Ir a contacto", atajo: "3", accion: "#contacto" },
  { texto: "Abrir el CV (PDF)", atajo: "C", accion: persona.cv },
  { texto: "Abrir GitHub", atajo: "G", accion: persona.github },
  { texto: "Abrir LinkedIn", atajo: "L", accion: persona.linkedin },
  { texto: "Copiar el correo", atajo: "", accion: "copiar" },
  { texto: "Leer sobre mí", atajo: "", accion: "#sobre-mi" },
  ...proyectos.map((p) => ({ texto: `Ver ${p.nombre}`, atajo: "", accion: `#${p.id}` })),
  ...(gaActivo ? [{ texto: "Preferencias de cookies", atajo: "", accion: "cookies" }] : []),
  { texto: "Desactivar atajos de una tecla", atajo: "", accion: "atajos" },
];
const archivos = [
  { id: "sobre-mi", nombre: "sobre-mi.md" },
  ...proyectos.map((p) => ({ id: p.id, nombre: `${p.id}.md` })),
];
const partirFechas = (fechas: string) => fechas.split(" – ");
const dosCifras = (n: number) => String(n).padStart(2, "0");

// Coloreado mínimo del YAML de agenteval: claves en blanco, cadenas en ámbar y null/números en azul.
const escapar = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const pintarYaml = (yaml: string) =>
  yaml
    .split("\n")
    .map((linea) => {
      const m = linea.match(/^(\s*-?\s*)([\w]+)(:)(\s*)(.*)$/);
      if (!m) return escapar(linea);
      const [, sangria, clave, dosPuntos, espacio, valor] = m;
      const clase = valor.startsWith('"') ? "y-s" : /^(null|true|false|\d+)$/.test(valor) ? "y-n" : "y-v";
      const pintado = valor ? `<span class="${clase}">${escapar(valor)}</span>` : "";
      return `${escapar(sangria)}<span class="y-k">${clave}</span>${dosPuntos}${espacio}${pintado}`;
    })
    .join("\n");

// La nota de agenteval, calculada con los pesos para que se vea de dónde sale.
const decimal = (n: number) => String(Math.round(n * 10) / 10).replace(".", ",");
const formula = (dimensiones: { peso: number; valor: number }[]) =>
  `${dimensiones.map((d) => `${decimal(d.peso / 100)} × ${d.valor}`).join(" + ")} = ${decimal(
    dimensiones.reduce((suma, d) => suma + (d.peso * d.valor) / 100, 0),
  )}`;
---

<Pagina titulo={titulo} descripcion={descripcion} grafo={grafo}>
  <div class="web" data-correo={persona.correo}>
    <!-- Barra de ventana -->
    <header class="ventana">
      <span class="ventana__puntos" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mono ventana__ruta">samuel@vigo: ~/portfolio</span>
      <a class="mono ventana__cv" href={persona.cv}>cv.pdf</a>
      <button class="mono ventana__k" type="button" data-abrir-paleta aria-haspopup="dialog">
        <kbd>Ctrl</kbd> <kbd>K</kbd> <span>comandos</span>
      </button>
    </header>

    <main id="contenido">
      <!-- Terminal: las órdenes reservan su sitio desde el principio para que nada salte al escribir. -->
      <section class="terminal" aria-label="Terminal con las pruebas de los proyectos" data-terminal>
        <div class="terminal__cuerpo mono">
          {
            sesionTerminal.map(({ comando, salida }) => (
              <div class="bloque">
                <p class="orden">
                  <span class="orden__prompt" aria-hidden="true">
                    <span class="prompt">samuel@vigo</span>
                    <span class="ruta">~</span>
                    <span class="dolar">$</span>
                  </span>
                  <span class="solo-lector">$ {comando}</span>
                  <span class="orden__comando" aria-hidden="true">
                    <span class="fantasma">{comando}</span>
                    <span class="tecleo" data-texto={comando}>
                      {comando}
                    </span>
                  </span>
                </p>
                {salida.tabla ? (
                  <pre class="salida salida--tabla">{salida.lineas.map((l) => <span class={l.includes("PROMEDIO") ? "bien" : undefined}>{`${l}\n`}</span>)}</pre>
                ) : (
                  <div class="salida">
                    {salida.lineas.map((l) => (
                      <p class={/^(OK|All tests)/.test(l) ? "bien" : undefined}>{l || " "}</p>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
          <div class="bloque">
            <p class="orden">
              <span class="orden__prompt" aria-hidden="true">
                <span class="prompt">samuel@vigo</span>
                <span class="ruta">~</span>
                <span class="dolar">$</span>
              </span>
              <span class="solo-lector">$ ls proyectos/</span>
              <span class="orden__comando" aria-hidden="true">
                <span class="fantasma">ls proyectos/</span>
                <span class="tecleo" data-texto="ls proyectos/">ls proyectos/</span>
              </span>
            </p>
            <ul class="salida ls" aria-label="Proyectos">
              {proyectos.map((p) => <li><a href={`#${p.id}`}>{p.id}/</a></li>)}
            </ul>
          </div>
          <p class="orden final" aria-hidden="true">
            <span class="orden__prompt">
              <span class="prompt">samuel@vigo</span>
              <span class="ruta">~</span>
              <span class="dolar">$</span>
            </span>
            <span class="cursor"></span>
          </p>
        </div>
        <div class="terminal__lado">
          <h1>
            {persona.nombre}<span class="naranja">.</span>
          </h1>
          <p>
            Desarrollador web en {persona.ciudad}. Python y TypeScript. En la terminal, las pruebas reales de
            mis proyectos: los comandos tal cual y lo que devuelven.
          </p>
          <p class="mono pista" data-pista>
            Pulsa <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> para moverte o <kbd>Ctrl</kbd> <kbd>K</kbd> para todo lo
            demás.
          </p>
          <button class="mono saltar" type="button" data-saltar>Saltar animación ↵</button>
        </div>
      </section>

      <!-- Barra de estado: resume lo que acaba de salir en la terminal. -->
      <div class="estado mono" role="group" aria-label="Estado de las pruebas">
        <span class="estado__rama">⎇ main</span>
        {estado.map((e) => <span>✓ {e}</span>)}
      </div>

      <!-- Perfil y proyectos como archivos abiertos en el editor -->
      <section id="proyectos" class="editor" aria-label="Sobre mí y proyectos">
        <nav class="pestanas mono" aria-label="Archivos">
          {
            archivos.map((a, i) => (
              <a href={`#${a.id}`} aria-current={i === 0 ? "true" : undefined}>
                {a.nombre}
              </a>
            ))
          }
        </nav>

        <article id="sobre-mi" class="archivo" aria-labelledby="sobre-mi-t">
          <p class="archivo__ruta mono">README.md</p>
          <div class="archivo__cuerpo archivo__cuerpo--perfil">
            <div class="archivo__texto">
              <p class="mono md" aria-hidden="true"># </p>
              <h2 id="sobre-mi-t">Sobre mí</h2>
              <p class="resumen">{sobreMi}</p>
            </div>
            <dl class="mono ficha">
              {
                datosPersonales.map((d) => (
                  <div>
                    <dt>{d.clave}</dt>
                    <dd>{d.valor}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </article>

        {
          proyectos.map((p, i) => (
            <article id={p.id} class="archivo proyecto" aria-labelledby={`${p.id}-t`}>
              <p class="archivo__ruta mono proyecto__ruta">
                <span>{`proyectos/${p.id}/README.md`}</span>
                <span aria-hidden="true">{`${dosCifras(i + 1)} / ${dosCifras(proyectos.length)}`}</span>
              </p>
              <header class="proyecto__cabeza">
                <p class="mono md" aria-hidden="true">
                  #{" "}
                </p>
                <h2 id={`${p.id}-t`}>{p.nombre}</h2>
                <p class="mono proyecto__etiqueta">{p.etiqueta}</p>
              </header>

              {p.demo === "video" && p.video && (
                <figure class="demo" data-video>
                  <div class="demo__marco">
                    <video
                      src={p.video.src}
                      poster={p.video.posterPagina ?? p.video.poster}
                      width={p.video.ancho}
                      height={p.video.alto}
                      muted
                      loop
                      playsinline
                      controls
                      preload="none"
                      aria-label={p.video.alt}
                    />
                  </div>
                  <div class="capitulos mono" role="group" aria-label="Fases de la grabación" data-capitulos>
                    {p.video.capitulos.map((c, j) => (
                      <button
                        type="button"
                        data-desde={c.desde}
                        data-hasta={p.video!.capitulos[j + 1]?.desde}
                        aria-label={`Ver la fase «${c.texto}» de la grabación`}
                      >
                        <span class="capitulos__barra" aria-hidden="true">
                          <i />
                        </span>
                        {c.texto}
                      </button>
                    ))}
                  </div>
                  <figcaption class="mono comentario">
                    // {p.video.pie}{" "}
                    <button type="button" class="video__boton" data-video-boton hidden>
                      ❚❚ pausar
                    </button>
                  </figcaption>
                </figure>
              )}

              {p.demo === "llamada" && (
                <figure class="demo">
                  <div class="llamada" data-llamada>
                    <div class="llamada__panel mono">
                      <p class="llamada__cabeza">
                        <span data-llamada-estado>llamada · restaurante de la demo</span>
                        <button type="button" class="llamada__repetir" data-llamada-repetir hidden>
                          ↻ repetir
                        </button>
                      </p>
                      <ol class="llamada__lineas">
                        {llamada.map(({ quien, texto }) => {
                          if (quien !== "herramienta") {
                            return (
                              <li class={`linea linea--${quien.toLowerCase()}`}>
                                <span class="linea__quien">{quien}</span>
                                <span>{texto}</span>
                              </li>
                            );
                          }
                          const [accion, resultado] = texto.split(" → ");
                          return (
                            <li class="linea linea--h">
                              <span class="linea__quien" aria-hidden="true">
                                →
                              </span>
                              <span>
                                <span class="solo-lector">Herramienta: </span>
                                {accion} <span class="linea__ok">→ {resultado}</span>
                              </span>
                            </li>
                          );
                        })}
                      </ol>
                    </div>
                    <div class="agenda" role="group" aria-label="Agenda del personal">
                      <p class="agenda__cabeza mono">agenda · {agenda.dia}</p>
                      <ul>
                        {agenda.franjas.map((hora) =>
                          hora === agenda.reserva.hora ? (
                            <li class="agenda__franja agenda__franja--reserva" data-agenda-reserva>
                              <span class="mono agenda__hora">{hora}</span>
                              <span class="agenda__reserva">
                                <strong>{agenda.reserva.nombre}</strong> · {agenda.reserva.personas} personas
                                <span class="mono agenda__origen">{agenda.reserva.origen}</span>
                              </span>
                            </li>
                          ) : (
                            <li class="agenda__franja">
                              <span class="mono agenda__hora">{hora}</span>
                              <span class="solo-lector">libre</span>
                            </li>
                          ),
                        )}
                      </ul>
                    </div>
                  </div>
                  <figcaption class="mono comentario">
                    // Una reserva del guion de la demo: lo que dice el cliente, las herramientas que llama el agente y lo
                    que ve el personal al colgar.
                  </figcaption>
                </figure>
              )}

              {p.demo === "evaluacion" && p.evaluacion && (
                <figure class="demo">
                  <div class="evaluacion" data-evaluacion>
                    <div class="evaluacion__caso">
                      <p class="mono evaluacion__archivo">{p.evaluacion.archivo}</p>
                      <pre class="mono yaml" set:html={pintarYaml(p.evaluacion.caso)} />
                    </div>
                    <div class="evaluacion__nota">
                      <ul class="barras">
                        {p.evaluacion.dimensiones.map((d) => (
                          <li class={d.valor >= 90 ? "barras--bien" : "barras--medio"} style={`--valor: ${d.valor}`}>
                            <span class="barras__nombre">{d.nombre}</span>
                            <span class="mono barras__como">
                              {d.peso} % · {d.como}
                            </span>
                            <span class="barras__pista" aria-hidden="true">
                              <i />
                            </span>
                            <span class="mono barras__valor">{d.valor}</span>
                          </li>
                        ))}
                      </ul>
                      <p class="evaluacion__total">
                        <span class="evaluacion__cifra">{p.evaluacion.total}</span>
                        <span class="mono">/ 100</span>
                      </p>
                      <p class="mono evaluacion__formula">{formula(p.evaluacion.dimensiones)}</p>
                    </div>
                  </div>
                  <figcaption class="mono comentario">// {p.evaluacion.fuente}</figcaption>
                </figure>
              )}

              <dl class="proyecto__cifras">
                {p.datos.map(({ valor, texto }) => (
                  <div>
                    <dt class="mono">{texto}</dt>
                    <dd>{valor}</dd>
                  </div>
                ))}
              </dl>

              <div class="proyecto__cuerpo">
                <div class="proyecto__texto">
                  <p class="resumen">{p.resumen}</p>
                  {p.detalle.map((d) => (
                    <p class="detalle">{d}</p>
                  ))}
                </div>
                <div class="proyecto__ficha">
                  <h3 class="mono md">
                    <span aria-hidden="true">## </span>stack
                  </h3>
                  <ul class="mono chips">
                    {p.stack.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                  <p class="enlaces">
                    {p.enlaces.length > 0 ? (
                      p.enlaces.map((e) => (
                        <a class="enlace-flecha" href={e.url}>
                          {e.texto}
                          <span class="solo-lector"> de {p.nombre}</span>
                        </a>
                      ))
                    ) : (
                      <span class="mono comentario">// repositorio privado: lo enseño en una llamada</span>
                    )}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </section>

      <!-- Experiencia y formación como log de git -->
      <section id="experiencia" class="git" aria-labelledby="git-t">
        <p class="mono md" aria-hidden="true">$ git log --oneline --graph trayectoria</p>
        <h2 id="git-t" class="solo-lector">Experiencia y formación</h2>
        <ol class="grafo">
          {
            experiencia.map((e) => {
              const [desde, hasta] = partirFechas(e.fechas);
              return (
                <li>
                  <span class="mono fecha">
                    <time datetime={e.inicio}>{desde}</time> – <time datetime={e.fin}>{hasta}</time>
                  </span>
                  <h3>
                    {e.puesto} <span>@ {e.empresa}</span>
                  </h3>
                  <ul>
                    {e.puntos.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </li>
              );
            })
          }
          {
            formacion.map((f) => (
              <li class="formacion">
                <span class="mono fecha">
                  <time datetime={f.inicio}>{f.inicio}</time> – <time datetime={f.fin}>{f.fin}</time>
                </span>
                <h3>
                  {f.titulo} <span>@ {f.centro}</span>
                </h3>
              </li>
            ))
          }
          <li class="formacion">
            <span class="mono fecha"><time datetime={cursos.fecha}>{cursos.fecha}</time></span>
            <h3>Cursos <span>@ {cursos.entidad}</span></h3>
            <ul><li>{cursos.lista}</li></ul>
          </li>
        </ol>
        <p class="mono md" aria-hidden="true">$ cat habilidades.json</p>
        <h3 class="solo-lector">Habilidades</h3>
        <pre class="mono json">{`{\n${habilidades.map((h) => `  "${h.grupo}": "${h.lista}"`).join(",\n")}\n}`}</pre>
      </section>

      <!-- Contacto -->
      <section id="contacto" class="contacto" aria-labelledby="contacto-t">
        <p class="mono md" aria-hidden="true">$ ./contactar.sh</p>
        <h2 id="contacto-t" class="solo-lector">Contacto</h2>
        <a class="contacto__grande" href={`mailto:${persona.correo}`}>Escríbeme<span class="naranja" aria-hidden="true">→</span></a>
        <ul class="mono contacto__lista">
          <li><span>correo</span><a href={`mailto:${persona.correo}`}>{persona.correo}</a></li>
          <li><span>linkedin</span><a href={persona.linkedin}>{persona.nombre}</a></li>
          <li><span>github</span><a href={persona.github}>Samuelmartinezduran</a></li>
          <li><span>cv</span><a href={persona.cv}>CV_Samuel_Martinez_Duran.pdf</a></li>
        </ul>
        <footer class="mono comentario pie">
          // © 2026 {persona.nombre} · hecha con Astro · <a href="/privacidad/">privacidad</a>
          {
            gaActivo && (
              <>
                {" "}
                · <button type="button" class="enlace-boton" data-cookies>cookies</button>
              </>
            )
          }{" "}
          · actualizada el <time datetime={actualizada}>{fechaLarga}</time>
        </footer>
      </section>
    </main>

    <!-- Paleta de comandos -->
    <dialog class="paleta" data-paleta aria-label="Paleta de comandos">
      <input
        class="mono"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="paleta-lista"
        aria-autocomplete="list"
        aria-label="Buscar comando"
        placeholder="Escribe un comando…"
        autocomplete="off"
        data-buscar
      />
      <ul id="paleta-lista" role="listbox" aria-label="Comandos" data-lista>
        {
          comandos.map((c, i) => (
            <li id={`comando-${i}`} role="option" data-accion={c.accion} aria-selected={i === 0 ? "true" : "false"}>
              <span data-texto-comando>{c.texto}</span>
              {c.atajo && <kbd class="mono">{c.atajo}</kbd>}
            </li>
          ))
        }
      </ul>
      <p class="mono paleta__pie">↑↓ moverse · ↵ abrir · esc cerrar</p>
    </dialog>
    <p class="mono aviso" role="status" data-aviso></p>
  </div>
</Pagina>

<script>
  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const raiz = document.querySelector<HTMLElement>(".web")!;
  const terminal = document.querySelector<HTMLElement>("[data-terminal]");
  const aviso = document.querySelector<HTMLElement>("[data-aviso]");
  const botonSaltar = document.querySelector<HTMLButtonElement>("[data-saltar]");

  // Terminal: teclea cada orden y muestra su salida. El espacio ya está reservado (ver CSS), así que no
  // empuja nada. Sin JS o con movimiento reducido, todo se ve de golpe.
  const esperar = (ms: number) => new Promise((r) => setTimeout(r, ms));
  let saltar = false;
  async function reproducir() {
    if (!terminal || quieto) {
      botonSaltar?.setAttribute("hidden", "");
      return;
    }
    terminal.classList.add("animando");
    const bloques = [...terminal.querySelectorAll<HTMLElement>(".bloque")];
    for (const b of bloques) {
      if (saltar) break;
      b.classList.add("activo");
      const t = b.querySelector<HTMLElement>(".tecleo")!;
      const texto = t.dataset.texto ?? "";
      t.textContent = "";
      for (const letra of texto) {
        if (saltar) break;
        t.textContent += letra;
        await esperar(16 + Math.random() * 22);
      }
      t.textContent = texto;
      await esperar(saltar ? 0 : 250);
      b.classList.add("hecho");
      await esperar(saltar ? 0 : 350);
    }
    terminal.querySelectorAll(".bloque").forEach((b) => b.classList.add("activo", "hecho"));
    terminal.classList.remove("animando");
    botonSaltar?.setAttribute("hidden", "");
  }
  botonSaltar?.addEventListener("click", () => {
    saltar = true;
    window.medir?.("saltar_animacion");
  });
  reproducir();

  // Vídeo: se reproduce solo cuando se ve y se puede pausar. Con movimiento reducido no arranca solo y
  // quedan los controles del navegador.
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((figura) => {
    const video = figura.querySelector("video");
    const boton = figura.querySelector<HTMLButtonElement>("[data-video-boton]");
    if (!video) return;

    // Fases: cada botón se llena según avanza el vídeo y, al pulsarlo, salta a su segundo. Funcionan también
    // con movimiento reducido, porque solo se mueven si la persona reproduce el vídeo.
    const fases = [...figura.querySelectorAll<HTMLButtonElement>("[data-capitulos] button")];
    const pintarFases = () => {
      const t = video.currentTime;
      fases.forEach((f) => {
        const desde = Number(f.dataset.desde);
        const hasta = f.dataset.hasta ? Number(f.dataset.hasta) : video.duration || desde + 4;
        const avance = Math.min(1, Math.max(0, (t - desde) / (hasta - desde)));
        f.style.setProperty("--avance", String(avance));
        if (t >= desde && t < hasta) f.setAttribute("aria-current", "step");
        else f.removeAttribute("aria-current");
      });
    };
    let cuadro = 0;
    const seguir = () => {
      pintarFases();
      if (!video.paused) cuadro = requestAnimationFrame(seguir);
    };
    video.addEventListener("play", () => (cuadro = requestAnimationFrame(seguir)));
    video.addEventListener("pause", () => cancelAnimationFrame(cuadro));
    video.addEventListener("seeked", pintarFases);
    fases.forEach((f) =>
      f.addEventListener("click", () => {
        video.currentTime = Number(f.dataset.desde);
        pintarFases();
        video.play().catch(() => {});
      }),
    );

    if (!boton || quieto) return;
    video.controls = false;
    boton.hidden = false;
    let pausadoAMano = false;
    const pintar = () => (boton.textContent = video.paused ? "▶ reproducir" : "❚❚ pausar");
    video.addEventListener("play", pintar);
    video.addEventListener("pause", pintar);
    boton.addEventListener("click", () => {
      pausadoAMano = !video.paused;
      if (video.paused) video.play().catch(() => {});
      else video.pause();
    });
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !pausadoAMano) video.play().catch(() => {});
        else if (!e.isIntersecting && !video.paused) video.pause();
      },
      { threshold: 0.25 },
    ).observe(video);
  });

  // Llamada del asistente: al llegar a ella se reproduce una vez, línea a línea, y al colgar la reserva entra en
  // la agenda. Todo está en el HTML desde el principio (oculto, pero ocupando su sitio), así que no salta nada.
  // Sin JS o con movimiento reducido se ve entera.
  document.querySelectorAll<HTMLElement>("[data-llamada]").forEach((caja) => {
    const lineas = [...caja.querySelectorAll<HTMLElement>(".linea")];
    const reserva = caja.querySelector<HTMLElement>("[data-agenda-reserva]");
    const estado = caja.querySelector<HTMLElement>("[data-llamada-estado]");
    const repetir = caja.querySelector<HTMLButtonElement>("[data-llamada-repetir]");
    if (quieto || lineas.length === 0) return;
    const textoInicial = estado?.textContent ?? "";
    let sonando = false;
    async function llamar() {
      if (sonando) return;
      sonando = true;
      if (repetir) repetir.hidden = true;
      lineas.forEach((l) => l.classList.remove("vista"));
      reserva?.classList.remove("vista");
      if (estado) estado.textContent = "● en llamada…";
      for (const l of lineas) {
        await esperar(l.classList.contains("linea--h") ? 450 : 900);
        l.classList.add("vista");
      }
      await esperar(700);
      reserva?.classList.add("vista");
      if (estado) estado.textContent = "✓ llamada terminada · reserva en la agenda";
      if (repetir) repetir.hidden = false;
      sonando = false;
    }
    caja.classList.add("llamada--animando");
    if (estado) estado.textContent = textoInicial;
    new IntersectionObserver(
      ([e], o) => {
        if (!e.isIntersecting) return;
        o.disconnect();
        llamar();
      },
      { threshold: 0.4 },
    ).observe(caja);
    repetir?.addEventListener("click", llamar);
  });

  // agenteval: las barras se llenan y aparece la nota cuando la evaluación entra en pantalla.
  document.querySelectorAll<HTMLElement>("[data-evaluacion]").forEach((caja) => {
    if (quieto) return;
    caja.classList.add("evaluacion--animando");
    new IntersectionObserver(
      ([e], o) => {
        if (!e.isIntersecting) return;
        o.disconnect();
        caja.classList.add("evaluacion--vista");
      },
      { threshold: 0.4 },
    ).observe(caja);
  });

  // Atajos de una tecla: se pueden desactivar (WCAG 2.1.4). La elección se recuerda en este navegador.
  const leerAtajos = () => {
    try {
      return localStorage.getItem("atajos") !== "no";
    } catch {
      return true;
    }
  };
  let atajos = leerAtajos();
  const pintarAtajos = () => {
    raiz.dataset.atajos = atajos ? "si" : "no";
    const opcion = document.querySelector<HTMLElement>("[data-accion='atajos'] [data-texto-comando]");
    if (opcion) opcion.textContent = atajos ? "Desactivar atajos de una tecla" : "Activar atajos de una tecla";
  };
  pintarAtajos();

  // Paleta de comandos (combobox con lista).
  const paleta = document.querySelector<HTMLDialogElement>("[data-paleta]")!;
  const buscar = paleta.querySelector<HTMLInputElement>("[data-buscar]")!;
  const opciones = [...paleta.querySelectorAll<HTMLElement>("[data-accion]")];
  let elegida = 0;

  const visibles = () => opciones.filter((o) => !o.hidden);
  function marcar(i: number) {
    const v = visibles();
    opciones.forEach((o) => o.setAttribute("aria-selected", "false"));
    if (v.length === 0) {
      buscar.removeAttribute("aria-activedescendant");
      return;
    }
    elegida = (i + v.length) % v.length;
    v[elegida].setAttribute("aria-selected", "true");
    buscar.setAttribute("aria-activedescendant", v[elegida].id);
    v[elegida].scrollIntoView({ block: "nearest" });
  }
  function abrirPaleta() {
    buscar.value = "";
    opciones.forEach((o) => (o.hidden = false));
    paleta.showModal();
    marcar(0);
    window.medir?.("abrir_paleta");
  }
  function mostrarAviso(texto: string) {
    if (!aviso) return;
    aviso.textContent = texto;
    aviso.classList.add("visible");
    setTimeout(() => aviso.classList.remove("visible"), 2200);
  }
  async function ejecutar(accion: string, nombre = accion) {
    if (paleta.open) paleta.close();
    window.medir?.("comando", { comando: nombre });
    if (accion === "copiar") {
      const correo = raiz.dataset.correo ?? "";
      try {
        await navigator.clipboard.writeText(correo);
        mostrarAviso(`Copiado: ${correo}`);
      } catch {
        location.href = `mailto:${correo}`;
      }
    } else if (accion === "cookies") {
      window.abrirConsentimiento?.();
    } else if (accion === "atajos") {
      atajos = !atajos;
      try {
        localStorage.setItem("atajos", atajos ? "si" : "no");
      } catch {
        // Sin almacenamiento vale para esta visita.
      }
      pintarAtajos();
      mostrarAviso(atajos ? "Atajos de una tecla activados" : "Atajos de una tecla desactivados");
    } else if (accion.startsWith("#")) {
      document.querySelector(accion)?.scrollIntoView({ behavior: quieto ? "auto" : "smooth" });
      history.replaceState(null, "", accion);
    } else {
      window.open(accion, "_blank", "noopener");
    }
  }

  buscar.addEventListener("input", () => {
    const normalizar = (s: string) => s.toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");
    const q = normalizar(buscar.value);
    opciones.forEach((o) => (o.hidden = !normalizar(o.textContent ?? "").includes(q)));
    marcar(0);
  });
  paleta.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") (e.preventDefault(), marcar(elegida + 1));
    if (e.key === "ArrowUp") (e.preventDefault(), marcar(elegida - 1));
    if (e.key === "Enter") {
      e.preventDefault();
      const v = visibles()[elegida];
      if (v) ejecutar(v.dataset.accion!, v.textContent?.trim());
    }
  });
  opciones.forEach((o) => o.addEventListener("click", () => ejecutar(o.dataset.accion!, o.textContent?.trim())));
  paleta.addEventListener("click", (e) => {
    if (e.target === paleta) paleta.close();
  });
  document.querySelectorAll("[data-abrir-paleta]").forEach((b) => b.addEventListener("click", abrirPaleta));
  document.querySelector("[data-cookies]")?.addEventListener("click", () => window.abrirConsentimiento?.());

  // Atajos globales. Ctrl/Cmd+K siempre; los de una tecla, solo si están activados.
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (paleta.open) paleta.close();
      else abrirPaleta();
      return;
    }
    if (paleta.open || e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.key === "Enter" && terminal?.classList.contains("animando")) {
      saltar = true;
      return;
    }
    if (!atajos) return;
    const mapa: Record<string, string> = {
      "1": "#proyectos",
      "2": "#experiencia",
      "3": "#contacto",
      c: document.querySelector<HTMLElement>("[data-accion$='.pdf']")?.dataset.accion ?? "",
      g: document.querySelector<HTMLElement>("[data-accion*='github.com']")?.dataset.accion ?? "",
      l: document.querySelector<HTMLElement>("[data-accion*='linkedin.com']")?.dataset.accion ?? "",
    };
    const destino = mapa[e.key.toLowerCase()];
    if (destino) ejecutar(destino, `atajo ${e.key.toLowerCase()}`);
  });

  // Contacto por correo, para saber si la web sirve para lo que está hecha.
  document.addEventListener("click", (e) => {
    if ((e.target as Element | null)?.closest?.("a[href^='mailto:']")) window.medir?.("contacto", { via: "correo" });
  });

  // Pestaña activa según el archivo visible.
  const pestanas = [...document.querySelectorAll<HTMLAnchorElement>(".pestanas a")];
  document.querySelectorAll(".archivo").forEach((a) =>
    new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        pestanas.forEach((p) => {
          if (p.getAttribute("href") === `#${a.id}`) p.setAttribute("aria-current", "true");
          else p.removeAttribute("aria-current");
        });
      },
      { rootMargin: "-40% 0px -50% 0px" },
    ).observe(a),
  );
</script>

<style>
  .web {
    --fondo: #0b0d11;
