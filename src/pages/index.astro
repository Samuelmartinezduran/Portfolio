  @media (max-width: 30rem) {
    .ventana__ruta {
      display: none;
    }
  }

  .terminal__cuerpo {
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 3rem) var(--margen);
    font-size: clamp(0.8125rem, 1.1vw, 0.9375rem);
    line-height: 1.7;
  }

  .bloque + .bloque {
    margin-top: 1.25rem;
  }

  .orden {
    display: flex;
    gap: 1ch;
  }

  .orden__prompt {
    flex: none;
  }

  /* La orden completa (invisible) y la que se teclea ocupan la misma celda: el alto no cambia. */
