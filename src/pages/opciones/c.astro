---
// Opción C · Herramienta de desarrollador: la portada es una terminal que ejecuta las pruebas reales,
// hay paleta de comandos (Ctrl/Cmd+K) y atajos, y cada proyecto se lee como un archivo abierto.
import Lienzo from "../../layouts/Lienzo.astro";
import {
  experiencia,
  formacion,
  habilidades,
  llamada,
  otrosProyectos,
  persona,
  proyectos,
  sesionTerminal,
} from "../../data/perfil";

const comandos = [
  { texto: "Ir a proyectos", atajo: "1", accion: "#proyectos" },
  { texto: "Ir a experiencia", atajo: "2", accion: "#experiencia" },
  { texto: "Ir a contacto", atajo: "3", accion: "#contacto" },
  { texto: "Abrir el CV (PDF)", atajo: "C", accion: persona.cv },
  { texto: "Abrir GitHub", atajo: "G", accion: persona.github },
  { texto: "Abrir LinkedIn", atajo: "L", accion: persona.linkedin },
  { texto: "Copiar el correo", atajo: "", accion: "copiar" },
  ...proyectos.map((p) => ({ texto: `Ver ${p.nombre}`, atajo: "", accion: `#${p.id}` })),
];
const archivo = (id: string) => `proyectos/${id}/README.md`;
---

<Lienzo titulo="Samuel Martínez Durán" opcion="C">
  <div class="c">
    <!-- Barra de ventana -->
    <header class="ventana">
      <span class="ventana__puntos" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mono ventana__ruta">samuel@vigo: ~/portfolio</span>
      <button class="mono ventana__k" type="button" data-abrir-paleta>
        <kbd>Ctrl</kbd> <kbd>K</kbd> <span>comandos</span>
      </button>
    </header>

    <!-- Terminal -->
    <section class="terminal" aria-label="Terminal" data-terminal>
      <div class="terminal__cuerpo mono">
        {
          sesionTerminal.map(({ comando, salida }) => (
            <div class="bloque">
              <p class="orden">
                <span class="prompt">samuel@vigo</span>
                <span class="ruta">~</span>
                <span class="dolar">$</span> <span class="tecleo" data-texto={comando}>{comando}</span>
              </p>
              <div class="salida">
                {salida.map((l) => (
                  <p class={l.startsWith("OK") || l.startsWith("All tests") || l.startsWith("score") ? "bien" : ""}>
                    {l || " "}
                  </p>
                ))}
              </div>
            </div>
          ))
        }
        <div class="bloque">
          <p class="orden">
            <span class="prompt">samuel@vigo</span>
            <span class="ruta">~</span>
            <span class="dolar">$</span> <span class="tecleo" data-texto="ls proyectos/">ls proyectos/</span>
          </p>
          <ul class="salida ls">
            {proyectos.map((p) => <li><a href={`#${p.id}`}>{p.id}/</a></li>)}
            {otrosProyectos.map((o) => <li><a href={o.enlace.url}>{o.nombre.toLowerCase().replaceAll(" ", "-")}↗</a></li>)}
          </ul>
        </div>
        <p class="orden final">
          <span class="prompt">samuel@vigo</span>
          <span class="ruta">~</span>
          <span class="dolar">$</span> <span class="cursor" aria-hidden="true"></span>
        </p>
      </div>
      <div class="terminal__lado">
        <h1>
          {persona.nombre}<span class="naranja">.</span>
        </h1>
        <p>
          Desarrollador web en {persona.ciudad}. Python, TypeScript e IA. Lo de la izquierda son las pruebas reales
          de mis proyectos: los comandos y sus resultados.
        </p>
        <p class="mono pista">
          Pulsa <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> para moverte o <kbd>Ctrl</kbd> <kbd>K</kbd> para todo lo demás.
        </p>
        <button class="mono saltar" type="button" data-saltar>Saltar animación ↵</button>
      </div>
    </section>

    <!-- Barra de estado -->
    <div class="estado mono" aria-label="Estado">
      <span class="estado__rama">⎇ main</span>
      <span>✓ 208 pruebas</span>
      <span>✓ 499 pruebas</span>
      <span>✓ score 87</span>
      <span class="estado__der"><i></i> disponible · enero 2027</span>
    </div>

    <!-- Proyectos como archivos -->
    <section id="proyectos" class="editor" aria-label="Proyectos">
      <div class="pestanas mono" role="list">
        {proyectos.map((p, i) => <a role="listitem" href={`#${p.id}`} class={i === 0 ? "activa" : ""}>{p.id}.md</a>)}
      </div>
      {
        proyectos.map((p) => (
          <article id={p.id} class="archivo" aria-labelledby={`${p.id}-t`}>
            <p class="archivo__ruta mono">{archivo(p.id)}</p>
            <div class="archivo__cuerpo">
              <div class="archivo__texto">
                <p class="mono md"># </p>
                <h2 id={`${p.id}-t`}>{p.nombre}</h2>
                <p class="mono etiqueta">{p.etiqueta}</p>
                <p class="resumen">{p.resumen}</p>
                {p.detalle.map((d) => <p class="detalle">{d}</p>)}
                <p class="mono md">## stack</p>
                <pre class="mono codigo">{`[${p.stack.map((s) => `"${s}"`).join(", ")}]`}</pre>
                <p class="mono md">## cifras</p>
                <table class="mono tabla">
                  <tbody>
                    {p.datos.map(({ valor, texto }) => (
                      <tr>
                        <td>{texto}</td>
                        <td class="cifra">{valor}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="enlaces">
                  {p.enlaces.length > 0 ? (
                    p.enlaces.map((e) => <a class="enlace-flecha" href={e.url}>{e.texto}</a>)
                  ) : (
                    <span class="mono comentario">// repositorio privado: lo enseño en una entrevista</span>
                  )}
                </p>
              </div>
              <div class="archivo__media">
                {p.imagen ? (
                  <img src={p.imagen.src} width={p.imagen.ancho} height={p.imagen.alto} alt={p.imagen.alt} loading="lazy" decoding="async" />
                ) : (
                  <pre class="mono log">{llamada.map(({ quien, texto }) => quien === "herramienta" ? <span class="log__h">{`  → ${texto}\n`}</span> : <span>{`[${quien.toLowerCase()}] ${texto}\n`}</span>)}</pre>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </section>

    <!-- Experiencia como log de git -->
    <section id="experiencia" class="git" aria-labelledby="git-t">
      <p class="mono md">$ git log --oneline --graph trayectoria</p>
      <h2 id="git-t" class="solo-lector">Experiencia y formación</h2>
      <ol class="grafo">
        {
          experiencia.map((e) => (
            <li>
              <span class="mono fecha">{e.fechas}</span>
              <h3>
                {e.puesto} <span>@ {e.empresa}</span>
              </h3>
              <ul>{e.puntos.map((p) => <li>{p}</li>)}</ul>
            </li>
          ))
        }
        {
          formacion.map((f) => (
            <li class="formacion">
              <span class="mono fecha">{f.fechas}</span>
              <h3>
                {f.titulo} <span>@ {f.centro}</span>
              </h3>
            </li>
          ))
        }
      </ol>
      <p class="mono md">$ cat habilidades.json</p>
      <pre class="mono json">{`{\n${habilidades.map((h) => `  "${h.grupo}": "${h.lista}"`).join(",\n")}\n}`}</pre>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="contacto">
      <p class="mono md">$ ./contactar.sh</p>
      <h2>Busco un puesto de desarrollador desde enero de 2027<span class="naranja">_</span></h2>
      <ul class="mono contacto__lista">
        <li><span>correo</span><a href={`mailto:${persona.correo}`}>{persona.correo}</a></li>
        <li><span>linkedin</span><a href={persona.linkedin}>{persona.nombre}</a></li>
        <li><span>github</span><a href={persona.github}>Samuelmartinezduran</a></li>
        <li><span>cv</span><a href={persona.cv}>CV_Samuel_Martinez_Duran.pdf</a></li>
      </ul>
      <p class="mono comentario">// © 2026 {persona.nombre} · hecha con Astro</p>
    </section>

    <!-- Paleta de comandos -->
    <dialog class="paleta" data-paleta aria-label="Paleta de comandos">
      <input class="mono" type="text" placeholder="Escribe un comando…" aria-label="Buscar comando" data-buscar />
      <ul role="listbox" data-lista>
        {
          comandos.map((c, i) => (
            <li role="option" data-accion={c.accion} aria-selected={i === 0 ? "true" : "false"}>
              <span>{c.texto}</span>
              {c.atajo && <kbd class="mono">{c.atajo}</kbd>}
            </li>
          ))
        }
      </ul>
      <p class="mono paleta__pie">↑↓ moverse · ↵ abrir · esc cerrar</p>
    </dialog>
    <p class="mono aviso" role="status" data-aviso></p>
  </div>
</Lienzo>

<script>
  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const terminal = document.querySelector<HTMLElement>("[data-terminal]");
  const aviso = document.querySelector<HTMLElement>("[data-aviso]");

  // Terminal: teclea cada orden y muestra su salida. Sin JS o con movimiento reducido, todo se ve ya.
  const esperar = (ms: number) => new Promise((r) => setTimeout(r, ms));
  let saltar = false;
  async function reproducir() {
    if (!terminal || quieto) return;
    terminal.classList.add("animando");
    const bloques = [...terminal.querySelectorAll<HTMLElement>(".bloque")];
    for (const b of bloques) {
      if (saltar) break;
      b.classList.add("activo");
      const t = b.querySelector<HTMLElement>(".tecleo")!;
      const texto = t.dataset.texto ?? "";
      t.textContent = "";
      for (const letra of texto) {
        if (saltar) break;
        t.textContent += letra;
        await esperar(28 + Math.random() * 40);
      }
      t.textContent = texto;
      await esperar(saltar ? 0 : 350);
      b.classList.add("hecho");
      await esperar(saltar ? 0 : 500);
    }
    terminal.classList.remove("animando");
    terminal.querySelectorAll(".bloque").forEach((b) => b.classList.add("activo", "hecho"));
    document.querySelector<HTMLElement>("[data-saltar]")?.setAttribute("hidden", "");
  }
  if (quieto) document.querySelector<HTMLElement>("[data-saltar]")?.setAttribute("hidden", "");
  document.querySelector("[data-saltar]")?.addEventListener("click", () => (saltar = true));
  reproducir();

  // Paleta de comandos.
  const paleta = document.querySelector<HTMLDialogElement>("[data-paleta]")!;
  const buscar = paleta.querySelector<HTMLInputElement>("[data-buscar]")!;
  const opciones = [...paleta.querySelectorAll<HTMLElement>("[data-accion]")];
  let elegida = 0;

  const visibles = () => opciones.filter((o) => !o.hidden);
  function marcar(i: number) {
    const v = visibles();
    if (v.length === 0) return;
    elegida = (i + v.length) % v.length;
    opciones.forEach((o) => o.setAttribute("aria-selected", "false"));
    v[elegida].setAttribute("aria-selected", "true");
    v[elegida].scrollIntoView({ block: "nearest" });
  }
  function abrirPaleta() {
    buscar.value = "";
    opciones.forEach((o) => (o.hidden = false));
    paleta.showModal();
    marcar(0);
  }
  async function ejecutar(accion: string) {
    paleta.close();
    if (accion === "copiar") {
      const correo = "samuelmartinezduran044@outlook.com";
      try {
        await navigator.clipboard.writeText(correo);
        mostrarAviso(`Copiado: ${correo}`);
      } catch {
        location.href = `mailto:${correo}`;
      }
    } else if (accion.startsWith("#")) {
      document.querySelector(accion)?.scrollIntoView({ behavior: quieto ? "auto" : "smooth" });
    } else {
      window.open(accion, "_blank", "noopener");
    }
  }
  function mostrarAviso(texto: string) {
    if (!aviso) return;
    aviso.textContent = texto;
    aviso.classList.add("visible");
    setTimeout(() => aviso.classList.remove("visible"), 2200);
  }

  buscar.addEventListener("input", () => {
    const q = buscar.value.toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");
    opciones.forEach((o) => {
      const t = (o.textContent ?? "").toLowerCase().normalize("NFD").replace(/\p{Diacritic}/gu, "");
      o.hidden = !t.includes(q);
    });
    marcar(0);
  });
  paleta.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") (e.preventDefault(), marcar(elegida + 1));
    if (e.key === "ArrowUp") (e.preventDefault(), marcar(elegida - 1));
    if (e.key === "Enter") {
      e.preventDefault();
      const v = visibles()[elegida];
      if (v) ejecutar(v.dataset.accion!);
    }
  });
  opciones.forEach((o) => o.addEventListener("click", () => ejecutar(o.dataset.accion!)));
  paleta.addEventListener("click", (e) => {
    if (e.target === paleta) paleta.close();
  });
  document.querySelectorAll("[data-abrir-paleta]").forEach((b) => b.addEventListener("click", abrirPaleta));

  // Atajos globales.
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      paleta.open ? paleta.close() : abrirPaleta();
      return;
    }
    if (paleta.open || e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    const mapa: Record<string, string> = { "1": "#proyectos", "2": "#experiencia", "3": "#contacto" };
    if (mapa[e.key]) ejecutar(mapa[e.key]);
    if (e.key === "Enter" && terminal?.classList.contains("animando")) saltar = true;
  });

  // Pestaña activa según el archivo visible.
  const pestanas = [...document.querySelectorAll<HTMLAnchorElement>(".pestanas a")];
  document.querySelectorAll(".archivo").forEach((a) =>
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) pestanas.forEach((p) => p.classList.toggle("activa", p.getAttribute("href") === `#${a.id}`));
      },
      { rootMargin: "-40% 0px -50% 0px" },
    ).observe(a),
  );
</script>

<style>
  .c {
    --fondo: #0b0d11;
    background: var(--grafito);
    color: var(--blanco);
    min-height: 100vh;
  }

  .naranja {
    color: var(--acento);
  }

  .c a {
    text-decoration-color: var(--acento);
  }

  kbd {
    display: inline-block;
    min-width: 1.4em;
    padding: 0.05em 0.35em;
    border: 1px solid var(--borde-oscuro);
    border-bottom-width: 2px;
    border-radius: 2px;
    font-family: var(--mono);
    font-size: 0.75em;
    text-align: center;
    color: var(--blanco);
  }

  .md {
    color: var(--acento);
    font-size: 0.875rem;
  }

  .comentario {
    color: #6b7280;
    font-size: 0.875rem;
  }

  /* Ventana */
  .ventana {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--margen);
    background: var(--fondo);
    border-bottom: 1px solid var(--borde-oscuro);
  }

  .ventana__puntos {
    display: flex;
    gap: 0.375rem;
  }

  .ventana__puntos i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--borde-oscuro);
  }

  .ventana__puntos i:first-child {
    background: var(--acento);
  }

  .ventana__ruta {
    font-size: 0.8125rem;
    color: var(--texto-2-oscuro);
  }

  .ventana__k {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    background: transparent;
    color: var(--texto-2-oscuro);
    border: 1px solid var(--borde-oscuro);
    border-radius: 2px;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .ventana__k:hover {
    border-color: var(--acento);
  }

  .ventana__k span {
    margin-left: 0.375rem;
  }

  @media (max-width: 30rem) {
    .ventana__k span {
      display: none;
    }
  }

  /* Terminal */
  .terminal {
    display: grid;
    min-height: min(calc(100vh - 6rem), 52rem);
    background: var(--fondo);
  }

  @media (min-width: 64rem) {
    .terminal {
      grid-template-columns: 7fr 5fr;
    }
  }

  .terminal__cuerpo {
    padding: clamp(1.25rem, 4vw, 3rem) var(--margen);
    font-size: clamp(0.8125rem, 1.1vw, 0.9375rem);
    line-height: 1.7;
    overflow-x: auto;
  }

  .bloque + .bloque {
    margin-top: 1.25rem;
  }

  .orden {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .prompt {
    color: #4ade80;
  }

  .ruta {
    color: #8f9fff;
  }

  .dolar {
    color: var(--texto-2-oscuro);
  }

  .salida {
    color: var(--texto-2-oscuro);
  }

  .salida .bien {
    color: #4ade80;
  }

  .ls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .ls a {
    color: #8f9fff;
    text-decoration: none;
  }

  .ls a:hover {
    text-decoration: underline;
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--acento);
    animation: parpadeo 1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .animando .bloque:not(.activo),
  .animando .final {
    display: none;
  }

  .animando .bloque.activo:not(.hecho) .salida {
    display: none;
  }

  .animando .bloque.activo:not(.hecho) .tecleo::after {
    content: "";
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--acento);
  }

  .terminal__lado {
    display: grid;
    align-content: end;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 3rem) var(--margen);
    border-top: 1px solid var(--borde-oscuro);
  }

  @media (min-width: 64rem) {
    .terminal__lado {
      border-top: 0;
      border-left: 1px solid var(--borde-oscuro);
    }
  }

  .terminal__lado h1 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .terminal__lado p {
    color: var(--texto-2-oscuro);
    max-width: 30rem;
  }

  .pista {
    font-size: 0.8125rem;
  }

  .saltar {
    justify-self: start;
    padding: 0.5rem 0.75rem;
    background: transparent;
    color: var(--blanco);
    border: 1px solid var(--borde-oscuro);
    border-radius: 2px;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .saltar:hover {
    border-color: var(--acento);
  }

  /* Barra de estado */
  .estado {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    padding: 0.375rem var(--margen);
    background: var(--acento);
    color: var(--grafito);
    font-size: 0.75rem;
  }

  .estado__der {
    margin-left: auto;
  }

  .estado__der i {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.375rem;
    border-radius: 50%;
    background: var(--grafito);
  }

  /* Editor */
  .editor {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .pestanas {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    overflow-x: auto;
    background: var(--fondo);
    border-bottom: 1px solid var(--borde-oscuro);
    font-size: 0.8125rem;
  }

  .pestanas a {
    padding: 0.75rem 1.25rem;
    color: var(--texto-2-oscuro);
    text-decoration: none;
    border-right: 1px solid var(--borde-oscuro);
    border-top: 2px solid transparent;
    white-space: nowrap;
  }

  .pestanas a.activa {
    color: var(--blanco);
    background: var(--grafito);
    border-top-color: var(--acento);
  }

  .archivo {
    padding: clamp(2.5rem, 6vw, 4.5rem) var(--margen) 0;
    max-width: calc(var(--contenedor) + 2 * var(--margen));
    margin-inline: auto;
    scroll-margin-top: 3rem;
  }

  .archivo__ruta {
    font-size: 0.75rem;
    color: #6b7280;
  }

  .archivo__cuerpo {
    display: grid;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .archivo__cuerpo {
      grid-template-columns: 5fr 7fr;
    }
  }

  .archivo__texto {
    display: grid;
    gap: 0.875rem;
    align-content: start;
  }

  .archivo__texto h2 {
    margin-top: -0.5rem;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .archivo__texto h2 + .etiqueta {
    font-size: 0.8125rem;
    color: var(--texto-2-oscuro);
  }

  .resumen {
    font-size: 1.125rem;
  }

  .detalle {
    color: var(--texto-2-oscuro);
    font-size: 1rem;
  }

  .codigo {
    margin: 0;
    white-space: pre-wrap;
    font-size: 0.875rem;
    color: #fbbf77;
  }

  .tabla {
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .tabla td {
