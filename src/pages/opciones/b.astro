---
// Opción B · Editorial: el carácter sale de la tipografía. Nombre enorme, los proyectos como un índice
// grande que se despliega, y una vista previa que sigue al cursor en escritorio.
import Lienzo from "../../layouts/Lienzo.astro";
import { cifras, experiencia, formacion, habilidades, llamada, otrosProyectos, persona, proyectos } from "../../data/perfil";

type Fila = {
  id: string;
  nombre: string;
  tipo: string;
  stack: string;
  imagen?: string;
  resumen: string;
  detalle: string[];
  datos: { valor: string; texto: string }[];
  enlaces: { texto: string; url: string }[];
};

const filas: Fila[] = [
  ...proyectos.map((p) => ({
    id: p.id,
    nombre: p.nombre,
    tipo: p.etiqueta,
    stack: p.stack.slice(0, 3).join(" · "),
    imagen: p.imagen?.src,
    resumen: p.resumen,
    detalle: p.detalle,
    datos: p.datos,
    enlaces: p.enlaces,
  })),
  ...otrosProyectos.map((o, i) => ({
    id: `otro-${i}`,
    nombre: o.nombre,
    tipo: "Proyecto propio",
    stack: o.stack,
    imagen: o.imagen,
    resumen: o.texto,
    detalle: [],
    datos: [],
    enlaces: [o.enlace],
  })),
];
---

<Lienzo titulo="Samuel Martínez Durán" opcion="B" tema="claro">
  <div class="b">
    <header class="barra contenedor mono">
      <span>SM — Portfolio 2026</span>
      <span class="barra__estado"><i></i> Disponible desde enero de 2027</span>
      <a href={persona.cv}>CV ↗</a>
    </header>

    <section class="nombre contenedor" aria-labelledby="nombre">
      <h1 id="nombre">
        <span class="nombre__linea">Samuel</span>
        <span class="nombre__linea">Martínez<span class="naranja">.</span></span>
      </h1>
      <div class="nombre__pie">
        <p class="mono">Desarrollador web<br />Vigo, España</p>
        <p class="nombre__intro">
          Construyo webs, agentes de IA y aplicaciones de escritorio, y los dejo probados. Ahora hago webs en una
          agencia de marketing; abajo, lo que he hecho por mi cuenta.
        </p>
        <ul class="mono nombre__enlaces">
          <li><a href={persona.github}>GitHub ↗</a></li>
          <li><a href={persona.linkedin}>LinkedIn ↗</a></li>
          <li><a href={`mailto:${persona.correo}`}>Correo ↗</a></li>
        </ul>
      </div>
    </section>

    <section class="indice contenedor" aria-labelledby="indice-titulo">
      <div class="indice__cab mono">
        <h2 id="indice-titulo">Proyectos ({String(filas.length).padStart(2, "0")})</h2>
        <span>Pasa el ratón para ver · haz clic para abrir</span>
      </div>
      <ol class="filas" data-filas>
        {
          filas.map((f, i) => (
            <li class="fila" data-imagen={f.imagen ?? ""} data-id={f.id}>
              <details open={i === 0}>
                <summary>
                  <span class="fila__num mono">{String(i + 1).padStart(2, "0")}</span>
                  <span class="fila__nombre">{f.nombre}</span>
                  <span class="fila__meta mono">
                    {f.tipo}
                    <br />
                    {f.stack}
                  </span>
                  <span class="fila__mas" aria-hidden="true">+</span>
                </summary>
                <div class="fila__detalle">
                  <div class="fila__texto">
                    <p class="fila__resumen">{f.resumen}</p>
                    {f.detalle.map((d) => (
                      <p>{d}</p>
                    ))}
                    {f.datos.length > 0 && (
                      <dl class="fila__datos">
                        {f.datos.map(({ valor, texto }) => (
                          <div>
                            <dt class="cifra">{valor}</dt>
                            <dd class="mono">{texto}</dd>
                          </div>
                        ))}
                      </dl>
                    )}
                    <p class="fila__enlaces">
                      {f.enlaces.length > 0 ? (
                        f.enlaces.map((e) => <a href={e.url}>{e.texto} ↗</a>)
                      ) : (
                        <span class="mono">Repositorio privado · lo enseño en una entrevista</span>
                      )}
                    </p>
                  </div>
                  {f.imagen ? (
                    <img src={f.imagen} alt="" loading="lazy" decoding="async" class="fila__imagen" />
                  ) : (
                    <ol class="mini-llamada mono">
                      {llamada.map(({ quien, texto }) => (
                        <li class={quien === "herramienta" ? "h" : ""}>
                          {quien !== "herramienta" && <b>{quien}</b>} {texto}
                        </li>
                      ))}
                    </ol>
                  )}
                </div>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cifras contenedor" aria-label="En cifras">
      {
        cifras.map(({ valor, texto }) => (
          <p>
            <span class="cifras__valor cifra">{valor}</span>
            <span class="cifras__texto mono">{texto}</span>
          </p>
        ))
      }
    </section>

    <section class="trayectoria contenedor" aria-labelledby="tray-titulo">
      <h2 id="tray-titulo" class="mono">Trayectoria</h2>
      <ol>
        {
          experiencia.map((e) => (
            <li>
              <span class="mono">{e.fechas}</span>
              <div>
                <h3>{e.empresa.split(",")[0]}</h3>
                <p class="trayectoria__puesto">{e.puesto}</p>
                <ul>{e.puntos.map((p) => <li>{p}</li>)}</ul>
              </div>
            </li>
          ))
        }
        {
          formacion.map((f) => (
            <li class="trayectoria__formacion">
              <span class="mono">{f.fechas}</span>
              <div>
                <h3>{f.titulo}</h3>
                <p class="trayectoria__puesto">{f.centro}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <dl class="herramientas">
        {
          habilidades.map((h) => (
            <div>
              <dt class="mono">{h.grupo}</dt>
              <dd>{h.lista}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="contacto">
      <div class="contenedor">
        <p class="mono">¿Hablamos?</p>
        <a class="contacto__grande" href={`mailto:${persona.correo}`}>Escríbeme<span class="naranja">→</span></a>
        <p class="contacto__datos mono">
          <span>{persona.correo}</span>
          <a href={persona.linkedin}>LinkedIn ↗</a>
          <a href={persona.github}>GitHub ↗</a>
          <a href={persona.cv}>CV ↗</a>
        </p>
      </div>
    </section>

    <div class="vista" aria-hidden="true" data-vista><img alt="" /></div>
  </div>
</Lienzo>

<script>
  // Vista previa que sigue al cursor sobre el índice (solo con ratón y movimiento permitido).
  const puntero = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const vista = document.querySelector<HTMLElement>("[data-vista]");
  const img = vista?.querySelector("img");
  const filas = document.querySelector<HTMLElement>("[data-filas]");

  if (puntero && vista && img && filas) {
    let x = 0,
      y = 0,
      vx = 0,
      vy = 0;
    const mover = () => {
      vx += (x - vx) * (quieto ? 1 : 0.18);
      vy += (y - vy) * (quieto ? 1 : 0.18);
      vista.style.transform = `translate(${vx}px, ${vy}px)`;
      requestAnimationFrame(mover);
    };
    requestAnimationFrame(mover);

    filas.addEventListener("pointermove", (e) => {
      x = e.clientX + 24;
      y = e.clientY - 120;
    });
    filas.querySelectorAll<HTMLElement>(".fila").forEach((fila) => {
      const resumen = fila.querySelector("summary");
      resumen?.addEventListener("pointerenter", () => {
        const src = fila.dataset.imagen;
        filas.classList.add("enfocado");
        fila.classList.add("activa");
        if (src && !fila.querySelector("details")?.open) {
          img.src = src;
          vista.classList.add("visible");
        }
      });
      resumen?.addEventListener("pointerleave", () => {
        filas.classList.remove("enfocado");
        fila.classList.remove("activa");
        vista.classList.remove("visible");
      });
      fila.querySelector("details")?.addEventListener("toggle", () => vista.classList.remove("visible"));
    });
  }
</script>

<style>
  .b {
    background: var(--blanco);
    color: var(--grafito);
  }

  .naranja {
    color: var(--acento);
  }

  .b a {
    text-decoration: none;
  }

  .b a:hover {
    text-decoration: underline;
    text-decoration-color: var(--acento);
  }

  .barra {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .barra__estado i {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.375rem;
    border-radius: 50%;
    background: var(--acento);
  }

  @media (max-width: 40rem) {
    .barra > span:first-child {
      display: none;
    }
  }

  /* Nombre */
  .nombre {
    padding-top: clamp(2rem, 6vw, 5rem);
  }

  .nombre h1 {
    font-size: clamp(4.25rem, 17.5vw, 16rem);
    font-weight: 600;
    line-height: 0.84;
    letter-spacing: -0.065em;
    margin-left: -0.05em;
  }

  .nombre__linea {
    display: block;
  }

  .nombre__pie {
    display: grid;
    gap: 1.5rem 2rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--grafito);
    font-size: 0.9375rem;
  }

  .nombre__pie .mono {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8125rem;
  }

  .nombre__intro {
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    max-width: 34rem;
  }

  @media (min-width: 56rem) {
    .nombre__pie {
      grid-template-columns: 3fr 6fr 3fr;
    }

    .nombre__enlaces {
      justify-self: end;
      text-align: right;
    }
  }

  /* Índice */
  .indice {
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .indice__cab {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--texto-2);
  }

  .indice__cab h2 {
    font-size: inherit;
    font-weight: 400;
    color: var(--grafito);
  }

  @media (max-width: 40rem) {
    .indice__cab span {
      display: none;
    }
  }

  .filas {
    border-top: 1px solid var(--grafito);
  }

  .fila {
    border-bottom: 1px solid var(--grafito);
    transition: opacity 300ms;
  }

  .filas.enfocado .fila:not(.activa) {
    opacity: 0.35;
  }

  summary {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(1rem, 2vw, 1.5rem);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .fila__num {
    font-size: 0.8125rem;
    color: var(--texto-2);
  }

  .fila__nombre {
    font-size: clamp(1.75rem, 5.5vw, 4.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fila.activa .fila__nombre {
    transform: translateX(0.75rem);
  }

  .fila__meta {
    display: none;
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: right;
    color: var(--texto-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .fila__mas {
    font-size: 1.75rem;
    font-weight: 300;
    transition: transform 300ms;
  }

  details[open] .fila__mas {
    transform: rotate(45deg);
    color: var(--acento);
  }

  @media (min-width: 56rem) {
    summary {
      grid-template-columns: 4rem 1fr 18rem 2rem;
    }

    .fila__meta {
      display: block;
    }
  }

  .fila__detalle {
    display: grid;
    gap: 2rem;
    padding: 0.5rem 0 2.5rem;
  }

  @media (min-width: 56rem) {
    .fila__detalle {
      grid-template-columns: 5fr 7fr;
      padding-left: 5rem;
    }
  }

  .fila__texto {
    display: grid;
    gap: 1rem;
    align-content: start;
    color: var(--texto-2);
    max-width: 34rem;
  }

  .fila__resumen {
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--grafito);
  }

  .fila__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-top: 0.5rem;
    color: var(--grafito);
  }

  .fila__datos dt {
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .fila__datos dd {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--texto-2);
  }

  .fila__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
    color: var(--grafito);
    font-weight: 500;
  }

  .fila__enlaces .mono {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--texto-2);
  }

  .fila__imagen {
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
    object-position: top left;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }

  .mini-llamada {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    background: var(--grafito);
    color: var(--blanco);
    border-radius: var(--radio);
    font-size: 0.8125rem;
  }

  .mini-llamada b {
    font-weight: 400;
    color: var(--acento);
    text-transform: uppercase;
    margin-right: 0.5rem;
  }

  .mini-llamada .h {
    padding-left: 0.75rem;
    border-left: 2px solid var(--acento);
    color: var(--texto-2-oscuro);
  }

  /* Vista que sigue al cursor */
  .vista {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20;
    width: 22rem;
    pointer-events: none;
    opacity: 0;
    scale: 0.92;
    transition:
      opacity 250ms,
      scale 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .vista.visible {
    opacity: 1;
    scale: 1;
  }

  .vista img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top left;
    border: 1px solid var(--grafito);
    border-radius: var(--radio);
  }

  /* Cifras */
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 2rem;
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .cifras p {
    display: grid;
    gap: 0.75rem;
  }

  .cifras__valor {
    white-space: nowrap;
    font-size: clamp(3rem, 6.2vw, 6rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .cifras p:first-child .cifras__valor {
    color: var(--acento-tinta);
  }

  .cifras__texto {
    max-width: 14rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.5;
    color: var(--texto-2);
  }

  /* Trayectoria */
  .trayectoria {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .trayectoria > h2 {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--grafito);
    font-size: 0.8125rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .trayectoria > ol > li {
    display: grid;
    gap: 0.5rem 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--borde);
  }

  .trayectoria > ol > li > .mono {
    font-size: 0.8125rem;
    color: var(--texto-2);
    padding-top: 0.6rem;
  }

  .trayectoria h3 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .trayectoria__formacion h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .trayectoria__puesto {
    margin-top: 0.25rem;
    color: var(--texto-2);
  }

  .trayectoria ul {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.75rem;
    max-width: 44rem;
  }

  .trayectoria ul li::before {
    content: "— ";
    color: var(--acento-tinta);
  }

  @media (min-width: 56rem) {
    .trayectoria > ol > li {
      grid-template-columns: 12rem 1fr;
    }
  }

  .herramientas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.5rem 2rem;
    margin-top: 3rem;
  }

  .herramientas dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--texto-2);
  }

  .herramientas dd {
    margin-top: 0.25rem;
  }

  /* Contacto */
  .contacto {
    padding-block: clamp(4rem, 9vw, 8rem) 6rem;
    background: var(--grafito);
    color: var(--blanco);
  }

  .contacto .mono {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--texto-2-oscuro);
  }

  .contacto__grande {
    display: block;
    margin-top: 1rem;
    font-size: clamp(4rem, 15vw, 13rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.06em;
    transition: color 300ms;
  }

  .contacto__grande:hover {
    color: var(--acento);
    text-decoration: none !important;
  }

  .contacto__grande span {
    display: inline-block;
    margin-left: 0.1em;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contacto__grande:hover span {
    transform: translateX(0.15em);
  }

  .contacto__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2.5rem;
  }

  .contacto__datos a {
    color: var(--blanco);
  }

  @media (prefers-reduced-motion: reduce) {
    .fila__nombre,
    .vista,
    .contacto__grande span {
      transition: none;
    }
  }
</style>
