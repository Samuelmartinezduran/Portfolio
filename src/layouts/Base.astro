---
import "../styles/global.css";
import { persona } from "../data/perfil";

interface Props {
  titulo: string;
  descripcion: string;
  /** Sin canonical y con noindex (404). */
  indexable?: boolean;
}

const { titulo, descripcion, indexable = true } = Astro.props;
const sitio = Astro.site!;
const canonica = new URL(Astro.url.pathname, sitio).href;
const imagen = new URL("/og.png", sitio).href;

// Datos estructurados de la persona. Sin foto: la retiró el 08/11/2026 (ADR «Sin foto»).
const esquema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": new URL("/#samuel", sitio).href,
      name: persona.nombre,
      jobTitle: persona.puesto,
      url: sitio.href,
      email: `mailto:${persona.correo}`,
      address: { "@type": "PostalAddress", addressLocality: persona.ciudad, addressCountry: "ES" },
      sameAs: [persona.github, persona.linkedin],
      knowsAbout: ["Python", "TypeScript", "Desarrollo web", "Agentes de IA", "PostgreSQL", "Astro"],
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#web", sitio).href,
      url: sitio.href,
      name: persona.nombre,
      inLanguage: "es-ES",
      author: { "@id": new URL("/#samuel", sitio).href },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content={persona.nombre} />
    {indexable ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#111318" />
    <meta name="google-site-verification" content="ULBMkq3C7Th-rGcKFbSXl418OZaEJ_9wEAvckRCcCRM" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {indexable && <script type="application/ld+json" set:html={JSON.stringify(esquema)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a class="cabecera__nombre" href="/">{persona.nombre}</a>
        <nav aria-label="Principal">
          <ul class="cabecera__nav">
            <li><a href="/#proyectos">Proyectos</a></li>
            <li><a href="/#experiencia">Experiencia</a></li>
            <li><a href="/#contacto">Contacto</a></li>
            <li><a class="cabecera__cv" href={persona.cv}>CV</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie oscura">
      <div class="contenedor pie__fila">
        <p>© {new Date().getFullYear()} {persona.nombre}</p>
        <p>
          Hecha con Astro, sin JavaScript en el navegador. <a href={persona.repoWeb}>Código en GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 1rem;
    top: -4rem;
    padding: 0.5rem 1rem;
    background: var(--grafito);
    color: var(--blanco);
    z-index: 10;
  }

  .saltar:focus {
    top: 1rem;
  }

  .cabecera {
    border-bottom: 1px solid var(--borde);
    background: var(--blanco);
  }

  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
  }

  .cabecera__nombre {
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .cabecera__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.9375rem;
  }

  .cabecera__nav a {
    text-decoration: none;
  }

  .cabecera__nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--acento);
  }

  .cabecera__nav a.cabecera__cv {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--grafito);
    border-radius: var(--radio);
    font-weight: 500;
  }

  @media (max-width: 40rem) {
    .cabecera__nombre {
      font-size: 0.9375rem;
    }

    .cabecera__nav li:not(:last-child) {
      display: none;
    }
  }

  .pie {
    padding-block: 2rem;
    border-top: 1px solid var(--borde-oscuro);
    font-size: 0.875rem;
    color: var(--texto-2-oscuro);
  }

  .pie__fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
</style>
