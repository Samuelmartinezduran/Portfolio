---
// Layout de las propuestas de /opciones/: solo el <head> común y una barra para cambiar de opción.
// Cada opción dibuja su propia cabecera y pie. No se indexan.
import Cabeza from "../components/Cabeza.astro";

interface Props {
  titulo: string;
  opcion: "A" | "B" | "C";
  tema?: "claro" | "oscuro";
}

const { titulo, opcion, tema = "oscuro" } = Astro.props;
const opciones = [
  { letra: "A", nombre: "Proyectos vivos", href: "/opciones/a/" },
  { letra: "B", nombre: "Editorial", href: "/opciones/b/" },
  { letra: "C", nombre: "Terminal", href: "/opciones/c/" },
];
---

<!doctype html>
<html lang="es" data-tema={tema}>
  <head>
    <Cabeza titulo={`${titulo} · Opción ${opcion}`} descripcion="Propuesta de diseño del portfolio." indexable={false} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <slot />
    <nav class="selector" aria-label="Propuestas de diseño">
      <span>Propuesta</span>
      {
        opciones.map((o) => (
          <a href={o.href} aria-current={o.letra === opcion ? "page" : undefined}>
            {o.letra} · {o.nombre}
          </a>
        ))
      }
    </nav>
  </body>
</html>

<style>
  .selector {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem;
    background: #111318;
    border: 1px solid #2c303a;
    border-radius: 2px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: #a3a9b6;
  }

  .selector span {
    padding-inline: 0.5rem;
  }

  .selector a {
    padding: 0.375rem 0.625rem;
    color: #f8fafc;
    text-decoration: none;
    border-radius: 2px;
  }

  .selector a[aria-current="page"] {
    background: #ff5f1f;
    color: #111318;
  }
</style>
